                    <include name="SV_003_VerifyFundAdvisorNotesStoryList"/>
                    <include name="SV_004_VerifyOpenFirstStoryDetail"/>
                    <include name="SV_005_VerifyFirstStoryDetailTopContent"/>
                    <include name="SV_006_VerifyFirstStoryDetailScrollContent"/>
                    <include name="SV_007_VerifyBackFromStoryDetailToList"/>
