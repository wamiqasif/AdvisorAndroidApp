<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite
        name="Analyst Choice Per Card Dynamic Fund Capture Suite"
        verbose="1"
        parallel="false"
        preserve-order="true"
        configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>

    <test name="Analyst Choice - Independent Card Fund Capture" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.AnalystChoiceTest"/>
        </classes>
    </test>

</suite>