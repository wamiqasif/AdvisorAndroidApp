<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Stock Analyst's Choice - Product Changes"
       verbose="1" parallel="false" preserve-order="true" configfailurepolicy="continue">
    <!-- Explicit for this module; overrides global/legacy login-method settings. -->
    <parameter name="loginMethod" value="PASSWORD"/>
    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>
    <test name="All product changes - TC_001 to TC_013" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.StockAnalystsChoiceChangebyProTest">
                <methods>
                    <!-- TC_001-TC_011 verify/reuse the configured active account.
                         TC_012 switches to lapsed only when needed; TC_013 reuses that session. -->
                    <include name="TC_001_VerifyActiveUserNavigation"/>
                    <include name="TC_002_VerifyTopBackButtonAndReturnToHub"/>
                    <include name="TC_003_VerifyAnalystsChoiceHeading"/>
                    <include name="TC_004_VerifyBuyHasNoDividendDefinition"/>
                    <include name="TC_005_VerifyNewHoldDefinitions"/>
                    <include name="TC_006_VerifyStockDrawerExpansionAndDismissal"/>
                    <include name="TC_007_VerifyEndOfListWidgetOnAllTabs"/>
                    <include name="TC_008_VerifyNavigationAndCreateWatchlist"/>
                    <include name="TC_009_VerifyDateSortingOnAllTabs"/>
                    <include name="TC_010_VerifyLastColumnHeadingOnAllTabs"/>
                    <include name="TC_011_VerifyWatchlistNameHelperText"/>
                    <include name="TC_012_VerifyLapsedSubscriptionPitchOnAllTabs"/>
                    <include name="TC_013_VerifyLapsedHorizontalScrollingOnAllTabs"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
