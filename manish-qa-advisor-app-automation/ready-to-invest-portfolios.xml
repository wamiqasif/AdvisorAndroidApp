<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite
        name="VRSA Ready to Invest Portfolios Dynamic Regression Suite"
        verbose="1"
        parallel="false"
        preserve-order="true"
        configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>

    <test name="Ready to Invest Portfolios - Analyst Picks Dynamic Validation" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.ReadyToInvestPortfoliosTest"/>
        </classes>
    </test>

</suite>