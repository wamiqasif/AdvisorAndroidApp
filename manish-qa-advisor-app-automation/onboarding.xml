<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Onboarding Module Suite"
       verbose="1"
       preserve-order="true"
       parallel="false">

    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>

    <test name="Onboarding Split Test Cases" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.OnboardingTest"/>
        </classes>
    </test>

</suite>