<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Advisor Login Routing and Combined Landing"
       verbose="1" parallel="false" preserve-order="true" configfailurepolicy="continue">
    <parameter name="loginMethod" value="PASSWORD"/>
    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>
    <test name="Login Routing and Combined Landing - TC_001 to TC_006" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.CombinedLandingTest">
                <methods>
                    <include name="TC_001_VerifyNonSubscriberLoginAndCombinedLanding"/>
                    <include name="TC_002_VerifyAllCombinedLandingContent"/>
                    <include name="TC_003_VerifyFundAdvisorSubscriptionAndBack"/>
                    <include name="TC_004_VerifyStockAdvisorSubscriptionAndBack"/>
                    <include name="TC_005_VerifyActiveSubscriberDefaultPortfolioAndHub"/>
                    <include name="TC_006_VerifyLapsedSubscriberDefaultPortfolioAndHub"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
