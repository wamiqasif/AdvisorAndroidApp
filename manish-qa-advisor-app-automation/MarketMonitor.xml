<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite
        name="Market Monitor Module Suite"
        verbose="1"
        parallel="false"
        preserve-order="true"
        configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>

    <test
            name="Market Monitor Test Cases"
            preserve-order="true">

        <classes>
            <class name="com.valueresearch.tests.MarketMonitorTest"/>
        </classes>

    </test>

</suite>