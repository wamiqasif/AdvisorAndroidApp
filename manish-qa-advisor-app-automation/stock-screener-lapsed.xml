<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Stock Screener - Lapsed User"
       verbose="1" parallel="false" preserve-order="true" configfailurepolicy="continue">
    <parameter name="loginMethod" value="PASSWORD"/>
    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>
    <!-- Lapsed (switched automatically, once) account. Every case added -->
    <test name="Lapsed user - SS_017 to SS_020, SS_030" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.StockScreenerTest">
                <methods>
                    <include name="SS_017_LapsedCreateNewScreenShowsSubscriptionPage"/>
                    <include name="SS_018_LapsedSavedTabShowsSubscriptionNudge"/>
                    <include name="SS_019_LapsedCustomViewShowsSubscriptionNudge"/>
                    <include name="SS_020_LapsedSaveScreenOpensSubscriptionPage"/>
                    <include name="SS_030_LapsedSeasonalOnlyCustomViewLocked"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>