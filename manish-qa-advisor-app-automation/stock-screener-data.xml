<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Stock Screener - Data"
       verbose="1" parallel="false" preserve-order="true" configfailurepolicy="continue">
    <parameter name="loginMethod" value="PASSWORD"/>
    <listeners>
        <listener class-name="com.valueresearch.listeners.ExtentTestListener"/>
    </listeners>
    <!-- Active account. Every case added -->
    <test name="Data - SS_009 to SS_016, SS_025 to SS_029" preserve-order="true">
        <classes>
            <class name="com.valueresearch.tests.StockScreenerTest">
                <methods>
                    <include name="SS_009_VerifyTopRatedStocksColumns"/>
                    <include name="SS_010_VerifyMomentumPicksColumns"/>
                    <include name="SS_011_VerifyInvestmentIdeasColumns"/>
                    <include name="SS_012_VerifyValueGuruColumns"/>
                    <include name="SS_013_VerifyValueResearchRatingsDefaultFilters"/>
                    <include name="SS_014_VerifyMomentumPicksDefaultFilters"/>
                    <include name="SS_015_VerifyInvestmentIdeasDefaultFilters"/>
                    <include name="SS_016_VerifyValueGuruDefaultFilters"/>
                    <include name="SS_025_VerifySeasonalColumns"/>
                    <include name="SS_026_StockRatingShowsUnrated"/>
                    <include name="SS_027_VerifyCustomViewColumns"/>
                    <include name="SS_028_AddColumnsOffersEps"/>
                    <include name="SS_029_AddColumnsListsAllColumns"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>